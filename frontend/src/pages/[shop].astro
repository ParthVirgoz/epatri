---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import {
  SITE_BRAND,
  canonicalHref,
  guestMenuMetaDescription,
  menuWebPageJsonLd,
  siteOrigin,
} from "../core/siteSeo";
export const prerender = false;

const { shop } = Astro.params;

const env = (import.meta as unknown as { env: Record<string, string | undefined> & { MODE: string } }).env;

// Debug: log what shop was accessed
// console.log("🖥️ [Server] Page accessed for shop:", shop);

let data = null as any;
let error = null as string | null;

// Prefer explicit env variable (Astro/Vite) first.
const apiBaseUrl =
  env.PUBLIC_API_URL ||
  (env.MODE === "production" ? "https://epatri-be.vercel.app/api/v1" : "http://localhost:5000/api/v1");

try {
  // Keep legacy UI/JS as-is; only adapt data source to current public API contract.
  const res = await fetch(`${apiBaseUrl}/public/${encodeURIComponent(shop || "")}`);

  if (!res.ok) {
    throw new Error("Shop not found");
  }

  const payload = await res.json();
  const locations = Array.isArray(payload?.locations) ? payload.locations : [];
  const picked =
    locations.find((l) => l?.has_menu) || locations[0] || null;
  const analyticsUsername = String(payload?.analytics_track_username || shop || "").trim();
  const resolvedShopName = String(payload?.business_name || "").trim();

  data = {
    shop_name: resolvedShopName || shop || "Menu",
    pdf_url: picked?.pdf_url || null,
    digital_menu: picked?.digital_menu || { categories: [] },
    guest_menu_format: picked?.guest_menu_format || "auto",
    interactive_theme: payload?.interactive_theme ?? null,
    analytics_track_username: analyticsUsername,
    business_id: payload?.business_id ?? picked?.business_id ?? null,
    location_id: picked?.location_id ?? picked?.id ?? null,
    menu_id: picked?.menu_id ?? null,
  };
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const partnerSignupBase = String(env.PUBLIC_PARTNER_SIGNUP_URL || "").replace(/\/$/, "");
const shopGuestFooterCta =
  String(env.PUBLIC_CREATE_MENU_CTA_URL || "").trim() ||
  (partnerSignupBase ? `${partnerSignupBase}/register` : new URL("/", Astro.url).href);
const shopGuestFooterHome = new URL("/", Astro.url).href;

const socialInstagram = String(env.PUBLIC_SOCIAL_INSTAGRAM || "").trim();
const socialX = String(env.PUBLIC_SOCIAL_X || "").trim();
const socialGithub = String(env.PUBLIC_SOCIAL_GITHUB || "").trim();
const socialLinkedin = String(env.PUBLIC_SOCIAL_LINKEDIN || "").trim();
const shopHasSocialRow = Boolean(socialInstagram || socialX || socialGithub || socialLinkedin);

const publicSite = typeof env.PUBLIC_SITE_URL === "string" ? env.PUBLIC_SITE_URL : "";
const origin = siteOrigin(Astro.url, publicSite);
const canonical = canonicalHref(Astro.url, publicSite);
const seoTitle =
  data && !error
    ? `${data.shop_name} | Digital menu — ${SITE_BRAND}`
    : error
      ? `Menu unavailable | ${SITE_BRAND}`
      : `Guest menu | ${SITE_BRAND}`;
const seoDesc =
  data && !error
    ? guestMenuMetaDescription(String(data.shop_name))
    : "This guest menu could not be loaded. It may have moved or is temporarily unavailable.";
const seoRobots = data && !error ? "index, follow" : "noindex, follow";
const seoLd =
  data && !error
    ? menuWebPageJsonLd({
        origin,
        canonical,
        pageName: String(data.shop_name),
        description: guestMenuMetaDescription(String(data.shop_name)),
      })
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data?.shop_name || "Menu"}</title>
    <SeoHead title={seoTitle} description={seoDesc} robots={seoRobots} jsonLd={seoLd} ogType="article" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
    ></script>

    <style is:global>
      :root {
        --bg-color: #121316;
        --container-bg: #1c1e24;
        --text-color: #ffffff;
        --theme-bg-color: #121316;
        --surface-text-color: #ffffff;
        --brand-name-color: #ffffff;
        --items-color: #ffffff;
        --category-text-color: #ff9423;
        --price-text-color: #ff9423;
        --card-bg-color: #1c1e24;
        /* ePatri brand — e (green), Patri (saffron) */
        --brand-e: #1e9459;
        --brand-patri: #ff9423;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: var(--theme-bg-color);
        color: var(--text-color);
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      /* ---------------------------
      Desktop Layout Styles
      --------------------------- */

      .layout-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        max-width: 1360px;
        margin: 0 auto;
        padding: 0 8px;
      }

      .sidebar {
        position: sticky;
        top: 40px;
        width: 200px;
        padding: 32px 12px 16px 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 30px;
      }

      .brand-name {
        margin: 0;
        font-size: 38px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        line-height: 1.1;
        color: var(--surface-text-color);
        /* color: var(--brand-name-color); */
      }

      .qr-container {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }

      .qr-code {
        width: 150px;
        height: 150px;
        background-color: white;
        padding: 10px;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      }

      .qr-container p {
        margin: 0;
        color: var(--surface-text-color);
        opacity: 0.75;
        font-size: 14px;
      }

      .menu-container {
        width: 100%;
        max-width: 800px;
        background-color: var(--card-bg-color);
        min-height: 100vh;
        padding: 24px 0 40px 0;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.6);
      }
      .menu-container.pdf {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        /* Reduced space between images */
      }

      .menu-image-wrapper {
        width: 100%;
        padding: 0 18px;
        box-sizing: border-box;
      }

      .menu-image-wrapper img {
        width: 100%;
        display: block;
        border-radius: 16px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        object-fit: contain;
        cursor: zoom-in;
        background-color: #2c303a;
        min-height: 300px;
      }

      /* Loading Skeleton Animation */
      @keyframes shine {
        to {
          background-position-x: -200%;
        }
      }

      .loading-skeleton {
        background: linear-gradient(
          110deg,
          #2c303a 8%,
          #363b47 18%,
          #2c303a 33%
        );
        background-size: 200% 100%;
        animation: 1.5s shine linear infinite;
        min-height: 300px;
      }

      /* ---------------------------
        Desktop Modal Styles
        --------------------------- */
      .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.95);
        z-index: 1000;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.3s ease,
          visibility 0.3s ease;
        backdrop-filter: blur(8px);
      }

      .modal.active {
        opacity: 1;
        visibility: visible;
      }

      .modal-content {
        max-width: 90vw;
        max-height: 95vh;
        border-radius: 10px;
        object-fit: contain;
        transform: scale(0.95);
        transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
      }

      .modal.active .modal-content {
        transform: scale(1);
      }

      .close-btn {
        position: absolute;
        top: 20px;
        right: 30px;
        color: #d1d1d1;
        font-size: 45px;
        font-weight: 300;
        cursor: pointer;
        z-index: 1001;
        transition:
          color 0.2s,
          transform 0.2s;
        line-height: 1;
      }

      .close-btn:hover {
        color: #ffffff;
        transform: scale(1.1);
      }

      /* Modal Navigation Buttons */
      .modal-nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border: none;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        font-size: 24px;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1002;
        transition: background 0.3s ease;
      }

      .modal-nav-btn:hover {
        background: rgba(255, 255, 255, 0.3);
      }

      .modal-nav-prev {
        left: 20px;
      }

      .modal-nav-next {
        right: 20px;
      }

      /* ---------------------------
                    Mobile App Style Wrapper 
                    (Only active via JS when mobile is detected)
                    --------------------------- */
      .mobile-only-layout {
        display: flex;
        flex-direction: column;
        width: 100%;
      }

      .mobile-only-layout img {
        width: 100%;
        display: block;
        border-radius: 0;
        box-shadow: none;
        margin: 0;
        padding: 0;
        min-height: 300px;
      }

      /* Hide modal UI completely when loaded as mobile */
      .mobile-hide {
        display: none !important;
      }

      /* Interactive menu — long text */
      .menu-title-heading {
        overflow-wrap: anywhere;
        word-break: break-word;
        hyphens: auto;
        -webkit-hyphens: auto;
      }
      .menu-cat-heading {
        overflow-wrap: anywhere;
        word-break: break-word;
        hyphens: auto;
        -webkit-hyphens: auto;
      }
      .menu-item-name {
        flex: 1;
        min-width: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
        hyphens: auto;
        -webkit-hyphens: auto;
      }
      .menu-item-desc-wrap {
        margin: 6px 0 0;
      }
      .menu-item-desc {
        margin: 0;
        font-size: 13px;
        line-height: 1.4;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .menu-item-desc.is-clamped {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .menu-item-desc-toggle {
        margin: 4px 0 0;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 2px;
        color: inherit;
        opacity: 0.88;
      }

      /* ---------------------------
                    Snap Toggle & Tooltip Styles
                    --------------------------- */
      html.snap-active {
        scroll-snap-type: y mandatory;
      }

      .snap-active .menu-image-wrapper,
      .snap-active .mobile-only-layout img {
        scroll-snap-align: center;
        scroll-snap-stop: always;
      }

      .snap-toggle-container {
        position: fixed;
        top: 15px;
        right: 15px;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
      }

      .snap-btn {
        background: #1c1e24;
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 8px 12px;
        border-radius: 20px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
        transition: background 0.2s;
        outline: none;
      }

      .snap-btn:hover {
        background: #2a2d36;
      }

      .toggle-switch {
        width: 32px;
        height: 18px;
        background: #363b47;
        border-radius: 9px;
        position: relative;
        transition: background 0.3s;
      }

      .toggle-switch::after {
        content: "";
        position: absolute;
        top: 2px;
        left: 2px;
        width: 14px;
        height: 14px;
        background: white;
        border-radius: 50%;
        transition: transform 0.3s;
      }

      html.snap-active #snapToggleBtn .toggle-switch,
      html.full-height-active #fullHeightToggleBtn .toggle-switch {
        background: var(--brand-e);
      }

      html.snap-active #snapToggleBtn .toggle-switch::after,
      html.full-height-active #fullHeightToggleBtn .toggle-switch::after {
        transform: translateX(14px);
      }

      /* Full Height Desktop Styles */
      @media screen and (min-width: 901px) {
        html.full-height-active .menu-container {
          gap: 0;
          padding: 0;
        }

        html.full-height-active .menu-image-wrapper {
          padding: 0;
        }

        html.full-height-active .menu-image-wrapper img {
          height: 100vh;
          border-radius: 0;
          box-shadow: none;
          object-fit: contain;
          background-color: transparent;
        }
      }

      @media screen and (max-width: 900px) {
        .desktop-only {
          display: none !important;
        }
      }

      .snap-tooltip {
        background: var(--brand-patri);
        color: #121316;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        max-width: 220px;
        position: relative;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition:
          opacity 0.3s,
          transform 0.3s,
          visibility 0.3s;
      }

      .snap-tooltip.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .snap-tooltip::after {
        content: "";
        position: absolute;
        top: -6px;
        right: 35px;
        border-width: 0 6px 6px 6px;
        border-style: solid;
        border-color: transparent transparent var(--brand-patri) transparent;
      }

      .snap-tooltip-close {
        position: absolute;
        top: 4px;
        right: 6px;
        background: none;
        border: none;
        color: #121316;
        font-size: 18px;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        font-weight: bold;
      }

      .snap-tooltip-close:hover {
        color: #ffffff;
      }

      .snap-tooltip p {
        margin: 0;
        padding-right: 15px;
        line-height: 1.4;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </head>

  <body class="at-menu">
    <div class="snap-toggle-container">
      <button id="snapToggleBtn" class="snap-btn">
        <span>Scroll Snap</span>
        <div class="toggle-switch"></div>
      </button>
      <button id="fullHeightToggleBtn" class="snap-btn desktop-only">
        <span>Full Height</span>
        <div class="toggle-switch"></div>
      </button>
      <div id="snapTooltip" class="snap-tooltip" aria-hidden="true">
        <button
          id="closeTooltip"
          class="snap-tooltip-close"
          aria-label="Close tooltip">&times;</button
        >
        <p>Try Scroll Snap for perfectly aligned pages as you scroll!</p>
      </div>
    </div>

    <main aria-label="Guest menu">
      <h1 class="sr-only">{data?.shop_name || "Guest menu"}</h1>
      <p class="sr-only">
        {data?.shop_name
          ? `${data.shop_name} digital guest menu. PDF pages are rendered below and can be zoomed.`
          : "Digital guest menu page."}
      </p>
      <div id="app-root"></div>
    </main>

    <script
      define:vars={{
        pdfUrl: data?.pdf_url ?? null,
        digitalMenu: data?.digital_menu ?? { categories: [] },
        guestMenuFormat: data?.guest_menu_format ?? "auto",
        interactiveTheme: data?.interactive_theme ?? null,
        shopName: data?.shop_name ?? "",
        error: error ?? null,
        shopUsername: data?.analytics_track_username ?? shop ?? "",
        analyticsBusinessId: data?.business_id ?? null,
        analyticsLocationId: data?.location_id ?? null,
        analyticsMenuId: data?.menu_id ?? null,
        apiBaseUrl: apiBaseUrl,
      }}
    >
      window.__MENU_DATA__ = {
        pdfUrl,
        digitalMenu,
        guestMenuFormat,
        interactiveTheme,
        shopName,
        error,
        shopUsername,
        analyticsBusinessId,
        analyticsLocationId,
        analyticsMenuId,
        apiBaseUrl,
      };
      // Inline Analytics Tracker
      class AnalyticsTrackerInline {
        constructor(apiBaseUrl = null) {
          this.apiBaseUrl = apiBaseUrl || this.getApiBaseUrl();
          this.sessionId = this.generateSessionId();
          this.geoSessionKey = "analyticsGeoLocation";
        }

        generateSessionId() {
          return `${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
        }

        getApiBaseUrl() {
          // 1) server-provided (Astro define:vars)
          if (this.apiBaseUrl) {
            return this.apiBaseUrl;
          }

          // 2) explicit env workaround
          if (window.__MENU_DATA__?.apiBaseUrl) {
            return window.__MENU_DATA__.apiBaseUrl;
          }

          const hostname = window.location.hostname;

          // 3) production explicit
          if (hostname.includes("epatri.vercel.app")) {
            return "https://epatri-be.vercel.app/api/v1";
          }

          // 4) local dev
          if (hostname === "localhost" || hostname === "127.0.0.1") {
            return "http://localhost:5000/api/v1";
          }

          // 5) last resort
          const protocol = window.location.protocol;
          return `${protocol}//${hostname}/api/v1`;
        }

        detectDeviceType() {
          const ua = navigator.userAgent.toLowerCase();
          if (/ipad|android(?!.*mobile)/.test(ua)) return 'tablet';
          if (/mobile|android|iphone|ipod|webos|blackberry|iemobile/.test(ua)) return 'mobile';
          return 'desktop';
        }

        getDeviceInfo() {
          return {
            user_agent: navigator.userAgent,
            device_type: this.detectDeviceType(),
            referrer: document.referrer || null,
            session_id: this.sessionId,
          };
        }

        async getIpLocationData() {
          try {
            const response = await fetch("https://ipapi.co/json/");
            if (response.ok) {
              const data = await response.json();
              return {
                country: data.country_name,
                region: data.region,
                ip_address: data.ip,
              };
            }
          } catch (err) {
            console.warn("Could not fetch IP location:", err);
          }
          return { country: null, region: null, ip_address: null };
        }

        async getGeolocationData() {
          return new Promise((resolve) => {
            if (!navigator.geolocation) {
              resolve({ latitude: null, longitude: null });
              return;
            }
            navigator.geolocation.getCurrentPosition(
              (position) => {
                resolve({
                  latitude: position.coords.latitude,
                  longitude: position.coords.longitude,
                });
              },
              () => {
                resolve({ latitude: null, longitude: null });
              },
              {
                enableHighAccuracy: false,
                timeout: 4500,
                maximumAge: 10 * 60 * 1000,
              },
            );
          });
        }

        getCachedGeoData() {
          try {
            const raw = sessionStorage.getItem(this.geoSessionKey);
            if (!raw) return null;
            const parsed = JSON.parse(raw);
            if (
              parsed &&
              typeof parsed.latitude === "number" &&
              typeof parsed.longitude === "number"
            ) {
              return { latitude: parsed.latitude, longitude: parsed.longitude };
            }
          } catch {}
          return null;
        }

        cacheGeoData(geoData) {
          try {
            if (
              geoData &&
              typeof geoData.latitude === "number" &&
              typeof geoData.longitude === "number"
            ) {
              sessionStorage.setItem(this.geoSessionKey, JSON.stringify(geoData));
            }
          } catch {}
        }

        async postTrack(shopUsername, payload) {
          try {
            const endpoint = `${this.apiBaseUrl}/analytics/shop/${shopUsername}/track`;
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
              body: JSON.stringify(payload),
            });
            if (!response.ok) {
              await response.text();
              return null;
            }
            return await response.json();
          } catch {
            return null;
          }
        }

        async trackMenuView(shopUsername, geoOverride = null) {
          try {
            const deviceInfo = this.getDeviceInfo();

            const locData = await this.getIpLocationData();

            const geoData = geoOverride || { latitude: null, longitude: null };

            const payload = {
              ...deviceInfo,
              ...locData,
              ...geoData,
              business_id: window.__MENU_DATA__?.analyticsBusinessId || null,
              location_id: window.__MENU_DATA__?.analyticsLocationId || null,
              menu_id: window.__MENU_DATA__?.analyticsMenuId || null,
              event_type: "view",
            };
            return await this.postTrack(shopUsername, payload);
          } catch {
            return null;
          }
        }

        saveSessionData(shopUsername, data) {
          try {
            const sessionData = {
              shop: shopUsername,
              sessionId: this.sessionId,
              startTime: Date.now(),
              ...data,
            };
            sessionStorage.setItem('analyticsSession', JSON.stringify(sessionData));
          } catch (err) {
            console.warn("Could not save session:", err);
          }
        }
      }

      // Initialize analytics tracking
      async function initializeAnalytics() {
        const shopUsername = window.__MENU_DATA__.shopUsername;

        if (!shopUsername) {
          return;
        }

        try {
          const tracker = new AnalyticsTrackerInline(apiBaseUrl);

          await tracker.trackMenuView(shopUsername);

          tracker.saveSessionData(shopUsername, { menuAccessed: true });

          const wireGeoOnFirstInteraction = () => {
            const interactionEvents = ["pointerdown", "keydown", "touchstart", "scroll"];
            let captured = false;

            const removeListeners = () => {
              interactionEvents.forEach((eventName) => {
                window.removeEventListener(eventName, onInteraction, { passive: true });
              });
            };

            const onInteraction = async () => {
              if (captured) return;
              captured = true;
              removeListeners();

              const cachedGeo = tracker.getCachedGeoData();
              if (cachedGeo) {
                await tracker.trackMenuView(shopUsername, cachedGeo);
                return;
              }

              const geoData = await tracker.getGeolocationData();
              if (
                typeof geoData?.latitude === "number" &&
                typeof geoData?.longitude === "number"
              ) {
                tracker.cacheGeoData(geoData);
                await tracker.trackMenuView(shopUsername, geoData);
              }
            };

            interactionEvents.forEach((eventName) => {
              window.addEventListener(eventName, onInteraction, {
                passive: true,
                once: true,
              });
            });
          };

          wireGeoOnFirstInteraction();
        } catch {}
      }

      // Run analytics after initial rendering to protect LCP/TTI.
      const scheduleAnalytics = () => {
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(() => {
            initializeAnalytics();
          }, { timeout: 2000 });
        } else {
          setTimeout(() => initializeAnalytics(), 1200);
        }
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", scheduleAnalytics);
      } else {
        scheduleAnalytics();
      }
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", async () => {
        const { pdfUrl, digitalMenu, guestMenuFormat, interactiveTheme, shopName, shopUsername, error } = window.__MENU_DATA__;
        const appRoot = document.getElementById("app-root");
        const categories = Array.isArray(digitalMenu?.categories) ? digitalMenu.categories : [];
        const hasDigital = categories.length > 0;
        const mode =
          guestMenuFormat === "interactive"
            ? hasDigital
              ? "interactive"
              : "none"
            : guestMenuFormat === "pdf"
              ? pdfUrl
                ? "pdf"
                : "none"
              : pdfUrl
                ? "pdf"
                : hasDigital
                  ? "interactive"
                  : "none";
        const t = interactiveTheme && typeof interactiveTheme === "object" ? interactiveTheme : {};
        const themeBgColor = String(t.surface || "#121316");
        const surfaceTextColor = String(t.surfaceTextColor || t.bodyTextColor || "#ffffff");
        const brandNameColor = String(t.brandNameColor || t.accent || "#ffffff");
        const itemsColor = String(t.itemsColor || t.bodyTextColor || "#ffffff");
        const categoryColor = String(t.categoryColor || t.categoryTextColor || "#FF9423");
        const priceColor = String(t.priceColor || t.priceTextColor || "#FF9423");
        const currencySymbol = String(t.currencySymbol || "Rs.");
        document.documentElement.style.setProperty("--theme-bg-color", themeBgColor);
        document.documentElement.style.setProperty("--bg-color", themeBgColor);
        document.documentElement.style.setProperty("--text-color", surfaceTextColor);
        document.documentElement.style.setProperty("--surface-text-color", surfaceTextColor);
        document.documentElement.style.setProperty("--brand-name-color", brandNameColor);
        document.documentElement.style.setProperty("--items-color", itemsColor);
        document.documentElement.style.setProperty("--category-text-color", categoryColor);
        document.documentElement.style.setProperty("--price-text-color", priceColor);
        /* Category + item list panel: fixed in :root as --card-bg-color (#1c1e24), not theme-overridden */

        const isPdfMode = mode === "pdf";

        // Scroll Snap logic
        const snapBtn = document.getElementById("snapToggleBtn");
        const snapTooltip = document.getElementById("snapTooltip");
        const closeTooltip = document.getElementById("closeTooltip");

        const snapFeatureSeen = localStorage.getItem("snapFeatureSeen");
        if (!isPdfMode) {
          if (snapBtn) snapBtn.style.display = "none";
          const fullBtn = document.getElementById("fullHeightToggleBtn");
          if (fullBtn) fullBtn.style.display = "none";
          if (snapTooltip) snapTooltip.style.display = "none";
          document.documentElement.classList.remove("snap-active");
          document.documentElement.classList.remove("full-height-active");
        }

        if (!snapFeatureSeen) {
          setTimeout(() => {
            if (snapTooltip) snapTooltip.classList.add("show");
          }, 2000);
        }

        const hideTooltip = () => {
          if (snapTooltip) snapTooltip.classList.remove("show");
          localStorage.setItem("snapFeatureSeen", "true");
        };

        if (closeTooltip) closeTooltip.addEventListener("click", hideTooltip);

        if (snapBtn)
          snapBtn.addEventListener("click", () => {
            document.documentElement.classList.toggle("snap-active");
            if (snapTooltip && snapTooltip.classList.contains("show")) {
              hideTooltip();
            } else {
              localStorage.setItem("snapFeatureSeen", "true");
            }
          });

        // Full Height logic (desktop only)
        const fullHeightBtn = document.getElementById("fullHeightToggleBtn");
        if (fullHeightBtn)
          fullHeightBtn.addEventListener("click", () => {
            document.documentElement.classList.toggle("full-height-active");
          });

        // Check if user is on a mobile-sized screen
        const isMobile = window.matchMedia("(max-width: 900px)").matches;

        // Basic loading skeleton text while processing PDF / interactive menu
        appRoot.innerHTML =
          '<div style="display:flex;justify-content:center;align-items:center;height:80vh;color:#a0a4b8;font-size:24px;">Loading Document...</div>';

        if (mode === "none") {
          appRoot.innerHTML = `
          <div style="display:flex;justify-content:center;align-items:center;height:80vh;color:#ff4444;font-size:24px;">
              No menu available
          </div>`;
          return;
        }

        if (mode === "interactive") {
          const esc = (v) =>
            String(v ?? "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[m] ?? m));
          const isMobileInteractive = window.matchMedia("(max-width: 900px)").matches;
          const menuInner = `
            <h1 class="menu-title-heading" style="margin: 50px 0 30px;color:${esc(brandNameColor)};font-size:28px;font-weight:700;text-align: center;">${esc(shopName)}</h1>
            ${categories
              .map((cat) => `
                <section style="margin-bottom:36px;">
                  <h2 class="menu-cat-heading" style="color:${esc(categoryColor)};font-size:20px;font-weight:800;text-transform:uppercase;letter-spacing:.03em;">${esc(cat?.name || "Menu")}</h2>
                  ${(Array.isArray(cat?.items) ? cat.items : [])
                    .map((it) => `
                      <article style="padding:10px 0;border-bottom:1px solid rgba(255,255,255,.08);">
                        <div style="display:flex;justify-content:space-between;gap:10px;align-items:baseline;">
                          <strong class="menu-item-name" style="color:${esc(itemsColor)};font-weight:600;">${esc(it?.name || "")}</strong>
                          ${it?.price != null && String(it.price) !== "" ? `<span style="color:${esc(priceColor)};font-weight:900;white-space:nowrap;">${esc(currencySymbol)} ${esc(it.price)}</span>` : ""}
                        </div>
                        ${it?.description ? `<div class="menu-item-desc-wrap" style="color:${esc(itemsColor)};opacity:0.72;"><p class="menu-item-desc is-clamped">${esc(it.description)}</p><button type="button" class="menu-item-desc-toggle" hidden aria-expanded="false">More</button></div>` : ""}
                      </article>
                    `)
                    .join("")}
                </section>
              `)
              .join("")}
          `;
          const html = isMobileInteractive
            ? `
              <div class="menu-container" style="max-width:100%;padding:18px 16px 7rem;">
                ${menuInner}
              </div>
            `
            : `
              <div class="layout-wrapper">
                <div class="sidebar">
                  <div class="qr-container">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(window.location.href)}" alt="QR Code" class="qr-code">
                    <p>Scan to view on your phone</p>
                  </div>
                </div>
                <div class="menu-container" style="padding:24px 24px 5rem;">
                  ${menuInner}
                </div>
              </div>
            `;
          appRoot.innerHTML = html;
          const wireMenuDescToggles = (root) => {
            root.querySelectorAll(".menu-item-desc-wrap").forEach((wrap) => {
              const p = wrap.querySelector(".menu-item-desc");
              const btn = wrap.querySelector(".menu-item-desc-toggle");
              if (!p || !btn) return;
              const refreshClampState = () => {
                p.classList.add("is-clamped");
                btn.hidden = true;
                btn.textContent = "More";
                btn.setAttribute("aria-expanded", "false");
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                    const overflow = p.scrollHeight > p.clientHeight + 1;
                    btn.hidden = !overflow;
                  });
                });
              };
              refreshClampState();
              btn.addEventListener("click", () => {
                const open = btn.getAttribute("aria-expanded") === "true";
                if (open) {
                  refreshClampState();
                } else {
                  p.classList.remove("is-clamped");
                  btn.setAttribute("aria-expanded", "true");
                  btn.textContent = "Hide";
                  btn.hidden = false;
                }
              });
            });
          };
          wireMenuDescToggles(appRoot);
          return;
        }

        const pdfjsLib = window["pdfjs-dist/build/pdf"];
        pdfjsLib.GlobalWorkerOptions.workerSrc =
          "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

        const renderPageToDataURL = async (pdf, pageNumber, scale = 2) => {
          const page = await pdf.getPage(pageNumber);
          const viewport = page.getViewport({ scale: scale });
          const canvas = document.createElement("canvas");
          const context = canvas.getContext("2d");
          canvas.height = viewport.height;
          canvas.width = viewport.width;
          await page.render({ canvasContext: context, viewport: viewport })
            .promise;
          return canvas.toDataURL("image/jpeg", 0.8);
        };

        try {
          const pdf = await pdfjsLib.getDocument(pdfUrl).promise;
          const totalPages = pdf.numPages;
          const placeholderSvg =
            "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1.414'%3E%3C/svg%3E";

          if (isMobile) {
            // Mobile flow
            appRoot.innerHTML = "";
            const wrapper = document.createElement("div");
            wrapper.className = "mobile-only-layout";
            const imgElements = [];

            for (let i = 1; i <= totalPages; i++) {
              const img = document.createElement("img");
              img.className = "loading-skeleton";
              img.src = placeholderSvg;
              img.alt = `${shopName || "Menu"} - page ${i}`;
              wrapper.appendChild(img);
              imgElements.push(img);
            }
            appRoot.appendChild(wrapper);

            // Intersection Observer for Lazy Loading
            const renderedPages = new Set();
            const renderQueue = new Set();
            let isRendering = false;

            const processQueue = async () => {
              if (isRendering || renderQueue.size === 0) return;
              isRendering = true;

              // Prioritize based on what was added to the queue first (what user scrolled to)
              const iterator = renderQueue.values();
              const pageToRender = iterator.next().value;
              renderQueue.delete(pageToRender);
              renderedPages.add(pageToRender);

              try {
                const dataUrl = await renderPageToDataURL(
                  pdf,
                  pageToRender,
                  1.25,
                );
                imgElements[pageToRender - 1].src = dataUrl;
                imgElements[pageToRender - 1].classList.remove(
                  "loading-skeleton",
                );
              } catch (error) {
                console.error(`Error rendering page ${pageToRender}:`, error);
                renderedPages.delete(pageToRender); // Allow retry if needed
              }

              isRendering = false;
              processQueue(); // Check if more were added while rendering
            };

            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    const pageNum = parseInt(entry.target.dataset.page);

                    // Prioritize the currently visible page
                    if (!renderedPages.has(pageNum)) {
                      // Add to front of queue conceptually by adding it first, then others
                      if (renderQueue.has(pageNum)) renderQueue.delete(pageNum);
                      const queueArray = Array.from(renderQueue);
                      renderQueue.clear();
                      renderQueue.add(pageNum);
                      queueArray.forEach((p) => renderQueue.add(p));
                      processQueue();
                    }

                    // Pre-load next and previous pages if possible
                    if (pageNum < totalPages && !renderedPages.has(pageNum + 1))
                      renderQueue.add(pageNum + 1);
                    if (pageNum > 1 && !renderedPages.has(pageNum - 1))
                      renderQueue.add(pageNum - 1);
                    processQueue();
                  }
                });
              },
              {
                rootMargin: "100% 0px", // Load comfortably ahead
                threshold: 0.1,
              },
            );

            // Add observer to elements
            imgElements.forEach((img, index) => {
              img.dataset.page = index + 1;
              observer.observe(img);
            });
          } else {
            // Desktop flow
            const desktopHTML = `
                    <div class="layout-wrapper">
                        <div class="sidebar">
                            <div class="qr-container">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(window.location.href)}" alt="QR Code" class="qr-code">
                                <p>Scan to view on your phone</p>
                            </div>
                        </div>
                        <div class="menu-container pdf" id="image-list"></div>
                    </div>

                    <!-- Zoom Preview Modal -->
                    <div class="modal" id="imageModal" aria-hidden="true">
                        <span class="close-btn" id="closeModal" aria-label="Close Preview">&times;</span>
                        <button class="modal-nav-btn modal-nav-prev" id="prevBtn" aria-label="Previous image">&#10094;</button>
                        <img class="modal-content" id="zoomedImage" src="" alt="Zoomed Menu Page">
                        <button class="modal-nav-btn modal-nav-next" id="nextBtn" aria-label="Next image">&#10095;</button>
                    </div>
                `;

            appRoot.innerHTML = desktopHTML;
            const container = document.getElementById("image-list");
            const menuImages = []; // keep track of all desktop images for Prev/Next logic

            // Generate skeletons
            for (let i = 1; i <= totalPages; i++) {
              const wrapper = document.createElement("div");
              wrapper.className = "menu-image-wrapper";

              const img = document.createElement("img");
              img.className = "loading-skeleton";
              img.src = placeholderSvg;
              img.alt = `${shopName || "Menu"} - page ${i}`;
              // Custom attribute to track index
              img.dataset.index = i - 1;

              wrapper.appendChild(img);
              container.appendChild(wrapper);
              menuImages.push(img);
            }

            // Intersection Observer for Lazy Loading
            const renderedPages = new Set();
            const renderQueue = new Set();
            let isRendering = false;

            const processQueue = async () => {
              if (isRendering || renderQueue.size === 0) return;
              isRendering = true;

              // Prioritize based on what was added to the queue first (what user scrolled to)
              const iterator = renderQueue.values();
              const pageToRender = iterator.next().value;
              renderQueue.delete(pageToRender);
              renderedPages.add(pageToRender);

              try {
                // Slightly reduced scale improves decode/render time while preserving readability.
                const dataUrl = await renderPageToDataURL(pdf, pageToRender, 1.6);
                menuImages[pageToRender - 1].src = dataUrl;
                menuImages[pageToRender - 1].classList.remove(
                  "loading-skeleton",
                );
              } catch (error) {
                console.error(`Error rendering page ${pageToRender}:`, error);
                renderedPages.delete(pageToRender);
              }

              isRendering = false;
              processQueue();
            };

            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    const pageNum = parseInt(entry.target.dataset.page);

                    // Prioritize the currently visible page
                    if (!renderedPages.has(pageNum)) {
                      // Add to front of queue conceptually by adding it first, then others
                      if (renderQueue.has(pageNum)) renderQueue.delete(pageNum);
                      const queueArray = Array.from(renderQueue);
                      renderQueue.clear();
                      renderQueue.add(pageNum);
                      queueArray.forEach((p) => renderQueue.add(p));
                      processQueue();
                    }

                    // Pre-load nearby pages
                    if (pageNum < totalPages && !renderedPages.has(pageNum + 1))
                      renderQueue.add(pageNum + 1);
                    if (pageNum > 1 && !renderedPages.has(pageNum - 1))
                      renderQueue.add(pageNum - 1);
                    processQueue();
                  }
                });
              },
              {
                rootMargin: "100% 0px", // Load ahead of scroll
                threshold: 0.1,
              },
            );

            // Add observer to elements
            menuImages.forEach((img, index) => {
              img.dataset.page = index + 1;
              observer.observe(img);
            });

            // 3. Modal & Navigation Logic
            const modal = document.getElementById("imageModal");
            const zoomedImage = document.getElementById("zoomedImage");
            const closeModal = document.getElementById("closeModal");
            const nextBtn = document.getElementById("nextBtn");
            const prevBtn = document.getElementById("prevBtn");

            let currentIndex = 0;

            const updateModalImage = (index) => {
              const targetImg = menuImages[index];
              zoomedImage.src = targetImg.src;
              zoomedImage.alt = targetImg.alt || `Menu Page ${index + 1}`;

              // Preload the background scrolling by scrolling the original image into view
              targetImg.scrollIntoView({ behavior: "auto", block: "center" });
            };

            const openModal = (index) => {
              currentIndex = parseInt(index);
              updateModalImage(currentIndex);
              modal.classList.add("active");
              document.body.style.overflow = "hidden";
            };

            const close = () => {
              modal.classList.remove("active");
              document.body.style.overflow = "";
              setTimeout(() => {
                if (!modal.classList.contains("active")) {
                  zoomedImage.src = "";
                }
              }, 300);
            };

            // Click image to open
            container.addEventListener("click", (e) => {
              if (
                e.target.tagName === "IMG" &&
                !e.target.classList.contains("loading-skeleton")
              ) {
                openModal(e.target.dataset.index);
              }
            });

            // Next / Prev button logic
            nextBtn.addEventListener("click", (e) => {
              e.stopPropagation(); // prevent modal background click
              if (currentIndex < totalPages - 1) {
                currentIndex++;
                updateModalImage(currentIndex);
              }
            });

            prevBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              if (currentIndex > 0) {
                currentIndex--;
                updateModalImage(currentIndex);
              }
            });

            // Close interactions
            closeModal.addEventListener("click", close);

            modal.addEventListener("click", (e) => {
              // Tap anywhere except the image and nav buttons to close
              if (e.target === modal) {
                close();
              }
            });

            document.addEventListener("keydown", (e) => {
              if (modal.classList.contains("active")) {
                if (e.key === "Escape") close();
                if (e.key === "ArrowRight") nextBtn.click();
                if (e.key === "ArrowLeft") prevBtn.click();
              }
            });
          }
        } catch (error) {
          console.error("Error rendering PDF:", error);
          appRoot.innerHTML =
            '<div style="display:flex;justify-content:center;align-items:center;height:80vh;color:#ff4444;font-size:24px;">Failed to load PDF document. Please make sure the file exists.</div>';
        }
      });

      // ----------------------------------------------------
      // BASIC CODE PROTECTION (ANTI-INSPECT)
      // ----------------------------------------------------

      // Disable Right Click
      document.addEventListener("contextmenu", (event) =>
        event.preventDefault(),
      );

      // Disable Common Developer Shortcut Keys
      document.onkeydown = function (e) {
        // F12
        if (e.key === "F12") {
          return false;
        }
        // Ctrl+Shift+I (Inspect)
        if (e.ctrlKey && e.shiftKey && e.key === "I") {
          return false;
        }
        // Ctrl+Shift+J (Console)
        if (e.ctrlKey && e.shiftKey && e.key === "J") {
          return false;
        }
        // Ctrl+Shift+C (Element selection)
        if (e.ctrlKey && e.shiftKey && e.key === "C") {
          return false;
        }
        // Ctrl+U (View Source)
        if (e.ctrlKey && e.key === "U") {
          return false;
        }
      };

      // Smoother DevTools Defense (Dimension & Performance Check)
      const devtools = function () {};
      devtools.toString = function () {
        this.opened = true;
      };

      setInterval(function () {
        const widthThreshold = window.outerWidth - window.innerWidth > 160;
        const heightThreshold = window.outerHeight - window.innerHeight > 160;

        if (widthThreshold || heightThreshold) {
          // Completely erase the content so they can't examine the DOM
          document.body.innerHTML = `
                    <div style="display:flex; justify-content:center; align-items:center; height:100vh; background:#121316; color:white; font-family:sans-serif; flex-direction:column;">
                        <h2>Developer Tools Detected</h2>
                        <p>Please close the inspector to view this website.</p>
                    </div>
                `;
        }
      }, 500);
    </script>
  </body>
</html>
