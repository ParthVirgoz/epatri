---
import SeoHead from "../components/SeoHead.astro";
import {
	collectSameAsFromEnv,
	DEFAULT_HOME_DESCRIPTION,
	DEFAULT_HOME_TITLE,
	HOME_META_KEYWORDS,
	homeJsonLdGraph,
	siteOrigin,
} from "../core/siteSeo";

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
}

const {
	title = DEFAULT_HOME_TITLE,
	description = DEFAULT_HOME_DESCRIPTION,
	keywords = HOME_META_KEYWORDS,
} = Astro.props;

const env = (import.meta as unknown as { env: Record<string, string | undefined> }).env;
const origin = siteOrigin(Astro.url, env.PUBLIC_SITE_URL);
const sameAs = collectSameAsFromEnv(env);
const homeLd = homeJsonLdGraph(origin, sameAs);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<SeoHead title={title} description={description} keywords={keywords} jsonLd={homeLd} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family:
			"Inter",
			system-ui,
			-apple-system,
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}
</style>
