---
import "../styles/global.css";
import BrandMark from "./BrandMark.astro";

type GuestMenuFormat = "auto" | "pdf" | "interactive";

type InteractiveTheme = {
  surface?: string;
  surfaceTextColor?: string;
  brandNameColor?: string;
  itemsColor?: string;
  categoryColor?: string;
  priceColor?: string;
  menuCardColor?: string;
  currencySymbol?: string;
  /** Legacy keys — still accepted from older stored JSON */
  bodyTextColor?: string;
  categoryTextColor?: string;
  priceTextColor?: string;
  cardColor?: string;
};

interface Props {
  title: string;
  shopDisplayName: string;
  analyticsTrackUsername: string;
  pdfUrl: string | null;
  digitalMenu: Record<string, unknown>;
  apiBaseUrl: string;
  partnerAdminBase: string;
  /** Optional tenant context for analytics (V2+) */
  analyticsBusinessId?: string | null;
  analyticsLocationId?: string | null;
  analyticsMenuId?: string | null;
  /** When set, guests see only PDF or only interactive — not both at once */
  guestMenuFormat?: GuestMenuFormat;
  /** Business theme for interactive listing (from `business_themes.theme` JSON) */
  interactiveTheme?: InteractiveTheme | null;
  /** Override “create your menu” hub URL (else PUBLIC_CREATE_MENU_CTA_URL, else partner admin /register, else this site /) */
  createMenuCtaUrl?: string;
  /** Override customer marketing home link (defaults to this page’s origin) */
  marketingSiteUrl?: string;
}

const {
  title,
  shopDisplayName,
  analyticsTrackUsername,
  pdfUrl,
  digitalMenu,
  apiBaseUrl,
  partnerAdminBase,
  analyticsBusinessId = null,
  analyticsLocationId = null,
  analyticsMenuId = null,
  guestMenuFormat = "auto",
  interactiveTheme = null,
  createMenuCtaUrl: createMenuCtaUrlProp,
  marketingSiteUrl: marketingSiteUrlProp,
} = Astro.props;

const envCta = String(import.meta.env.PUBLIC_CREATE_MENU_CTA_URL || "").trim();
const resolvedCreateMenuUrl =
  (createMenuCtaUrlProp && String(createMenuCtaUrlProp).trim()) ||
  envCta ||
  (partnerAdminBase ? `${partnerAdminBase.replace(/\/$/, "")}/register` : new URL("/", Astro.url).href);
const resolvedMarketingHome =
  (marketingSiteUrlProp && String(marketingSiteUrlProp).trim()) || new URL("/", Astro.url).href;

const socialInstagram = String(import.meta.env.PUBLIC_SOCIAL_INSTAGRAM || "").trim();
const socialX = String(import.meta.env.PUBLIC_SOCIAL_X || "").trim();
const socialGithub = String(import.meta.env.PUBLIC_SOCIAL_GITHUB || "").trim();
const socialLinkedin = String(import.meta.env.PUBLIC_SOCIAL_LINKEDIN || "").trim();
const hasSocialRow = Boolean(socialInstagram || socialX || socialGithub || socialLinkedin);

const dm = interactiveTheme && typeof interactiveTheme === "object" ? interactiveTheme : {};
/** Fixed panel behind categories + items (not theme-overridden) for consistent readability */
const dmCard = "#1c1e24";
const dmCatColor = String(dm.categoryColor || dm.categoryTextColor || "#FF9423");
const dmItemsColor = String(dm.itemsColor || dm.bodyTextColor || "#ffffff");
const dmPriceColor = String(dm.priceColor || dm.priceTextColor || "#FF9423");
const digitalFontHref =
  "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap";
const digitalSectionStyle = [
  `--dm-card-bg:${dmCard}`,
  `--dm-cat-color:${dmCatColor}`,
  `--dm-items-color:${dmItemsColor}`,
  `--dm-price-color:${dmPriceColor}`,
  `--dm-cat-gap:14px`,
  `--dm-item-gap:10px`,
].join(";");

const hasPdf = Boolean(pdfUrl);
const cats = Array.isArray((digitalMenu as { categories?: unknown }).categories)
  ? (digitalMenu as {
      categories: {
        name?: string;
        items?: { name?: string; description?: string; price?: string | number; badges?: string[] }[];
      }[];
    }).categories
  : [];
const hasDigital = cats.length > 0;

const selectedMode: "pdf" | "interactive" | "none" =
  guestMenuFormat === "pdf"
    ? hasPdf
      ? "pdf"
      : "none"
    : guestMenuFormat === "interactive"
      ? hasDigital
        ? "interactive"
        : "none"
      : hasDigital
        ? "interactive"
        : hasPdf
          ? "pdf"
          : "none";
const showPdfPanel = selectedMode === "pdf";
const showDigitalPanel = selectedMode === "interactive";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {
      showDigitalPanel ? (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link href={digitalFontHref} rel="stylesheet" />
        </>
      ) : null
    }
    <style>
      :root {
        --brand-e: #1e9459;
        --brand-e-dark: #167a4a;
        --brand-patri: #ff9423;
        --app-bg: #0c0c0e;
        --surface: #141416;
        --border: rgba(255, 255, 255, 0.1);
        --text: #f5f5f5;
        --muted: #a3a3a3;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        background: var(--app-bg);
        color: var(--text);
        font-size: 15px;
      }
      body.pdf-legacy {
        background: #0a0a0c;
        color: #ffffff;
      }
      .top {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 52px;
        border-bottom: 1px solid var(--border);
        background: rgba(12, 12, 14, 0.92);
        backdrop-filter: blur(8px);
      }
      .brand {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .brand .e {
        color: var(--brand-e);
      }
      .brand .p {
        color: var(--brand-patri);
      }
      main {
        width: min(920px, 100%);
        margin: 0 auto;
        padding: 16px 12px 28px;
      }
      h1 {
        margin: 0 0 6px;
        text-align: center;
        font-size: clamp(1.25rem, 4vw, 1.75rem);
      }
      .sub {
        margin: 0 0 14px;
        text-align: center;
        color: var(--muted);
        font-size: 13px;
      }
      .panel {
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        overflow: hidden;
      }
      .loading {
        padding: 14px;
        text-align: center;
        color: var(--muted);
        font-size: 14px;
        border-bottom: 1px solid var(--border);
      }
      iframe {
        width: 100%;
        height: min(82vh, 900px);
        border: 0;
        display: block;
      }
      .legacy-pdf-root {
        width: min(1200px, 100%);
        margin: 0 auto;
        padding: 0 16px 32px;
      }
      .legacy-layout {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 8px;
      }
      .legacy-sidebar {
        position: sticky;
        top: 26px;
        width: 220px;
        padding: 32px 12px 16px 0;
      }
      .legacy-brand {
        margin: 0;
        font-size: 28px;
        line-height: 1.15;
        color: #ffffff;
      }
      .legacy-qr {
        margin-top: 18px;
        display: inline-flex;
        flex-direction: column;
        gap: 8px;
        color: #a0a4b8;
        font-size: 13px;
      }
      .legacy-qr img {
        width: 132px;
        height: 132px;
        background: #fff;
        border-radius: 8px;
        padding: 8px;
      }
      .legacy-menu {
        width: 100%;
        max-width: 820px;
        min-height: 70vh;
        background: #1c1e24;
        border-radius: 14px;
        box-shadow: 0 0 36px rgba(0, 0, 0, 0.5);
        padding: 28px 0 40px;
      }
      .legacy-page {
        width: 100%;
        padding: 0 24px;
        margin-bottom: 10px;
      }
      .legacy-page img {
        width: 100%;
        display: block;
        border-radius: 14px;
        background: #2c303a;
        min-height: 260px;
        object-fit: contain;
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.35);
        cursor: zoom-in;
      }
      .legacy-loading {
        color: #a0a4b8;
        text-align: center;
        font-size: 14px;
        padding: 10px 0 20px;
      }
      .legacy-modal {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.95);
        display: none;
        z-index: 999;
        justify-content: center;
        align-items: center;
      }
      .legacy-modal.active { display: flex; }
      .legacy-modal img {
        max-width: 92vw;
        max-height: 92vh;
        border-radius: 10px;
      }
      @media (max-width: 900px) {
        .legacy-sidebar { display: none; }
        .legacy-pdf-root { padding: 0; }
        .legacy-menu {
          border-radius: 0;
          max-width: 100%;
          min-height: 100dvh;
          padding: 0;
          box-shadow: none;
          background: #121316;
        }
        .legacy-page {
          padding: 0;
          margin: 0;
        }
        .legacy-page img {
          border-radius: 0;
          min-height: 220px;
          box-shadow: none;
          cursor: default;
        }
      }
      .digital {
        padding: 16px 14px 20px;
        background: var(--dm-card-bg, #1c1e24);
        color: var(--dm-items-color, #ffffff);
        font-family: "Inter", system-ui, sans-serif;
      }
      .cat {
        margin-bottom: var(--dm-cat-gap, 18px);
      }
      .cat h2 {
        margin: 0 0 10px;
        font-size: 15px;
        font-family: "Inter", system-ui, sans-serif;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--dm-cat-color, #ff9423);
        overflow-wrap: anywhere;
        word-break: break-word;
        hyphens: auto;
        -webkit-hyphens: auto;
      }
      .item {
        padding: var(--dm-item-gap, 10px) 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .item:last-child {
        border-bottom: 0;
      }
      .row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: baseline;
      }
      .name {
        flex: 1;
        min-width: 0;
        font-weight: 600;
        color: var(--dm-items-color, #ffffff);
        overflow-wrap: anywhere;
        word-break: break-word;
        hyphens: auto;
        -webkit-hyphens: auto;
      }
      .price {
        font-weight: 700;
        color: var(--dm-price-color, #ff9423);
        white-space: nowrap;
      }
      .menu-item-desc-wrap {
        margin: 4px 0 0;
        color: var(--dm-items-color, #ffffff);
        opacity: 0.72;
      }
      .menu-item-desc {
        margin: 0;
        font-size: 13px;
        line-height: 1.4;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .menu-item-desc.is-clamped {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .menu-item-desc-toggle {
        margin: 4px 0 0;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 2px;
        color: inherit;
        opacity: 0.88;
      }
      .badges {
        margin-top: 6px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .badge {
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 999px;
        background: rgba(255, 148, 35, 0.18);
        color: #8b4510;
      }
      .empty {
        text-align: center;
        padding: 28px 16px;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="brand"><span class="e">e</span><span class="p">Patri</span></div>
    </header>
    <main>
      <h1>{shopDisplayName}</h1>
      <p class="sub">Menu</p>

      {!showPdfPanel && !showDigitalPanel ? (
        <div class="panel">
          <div class="empty">No menu online for this outlet yet.</div>
        </div>
      ) : null}

      {
        showPdfPanel ? (
          <section class="legacy-pdf-root" id="panelPdf">
            <div class="legacy-layout">
              <aside class="legacy-sidebar">
                <h2 class="legacy-brand">{shopDisplayName}</h2>
                <div class="legacy-qr">
                  <img src={`https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(Astro.url.href)}`} alt="QR" />
                  <span>Scan to open on your phone</span>
                </div>
              </aside>
              <div class="legacy-menu">
                <div id="legacyPdfLoading" class="legacy-loading">Loading menu…</div>
                <div id="legacyPdfList"></div>
              </div>
            </div>
            <div id="legacyPdfModal" class="legacy-modal">
              <img id="legacyPdfModalImg" alt="Menu page zoom" />
            </div>
          </section>
        ) : null
      }

      {
        showDigitalPanel ? (
          <section class="panel" id="panelDigital" style={digitalSectionStyle}>
            <div class="digital">
              {cats.map((c) => (
                <div class="cat">
                  <h2>{c.name || "Menu"}</h2>
                  {(c.items || []).map((it) => (
                    <div class="item">
                      <div class="row">
                        <span class="name">{it.name}</span>
                        {it.price != null && it.price !== "" ? <span class="price">{it.price}</span> : null}
                      </div>
                      {it.description ? (
                        <div class="menu-item-desc-wrap">
                          <p class="menu-item-desc is-clamped">{it.description}</p>
                          <button type="button" class="menu-item-desc-toggle" hidden aria-expanded="false">
                            More
                          </button>
                        </div>
                      ) : null}
                      {it.badges && it.badges.length ? (
                        <div class="badges">
                          {it.badges.map((b) => (
                            <span class="badge">{b}</span>
                          ))}
                        </div>
                      ) : null}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </section>
        ) : null
      }

    </main>

    <script is:inline>
      (function () {
        function wireGuestDescToggles() {
          const root = document.getElementById("panelDigital");
          if (!root) return;
          root.querySelectorAll(".menu-item-desc-wrap").forEach((wrap) => {
            const p = wrap.querySelector(".menu-item-desc");
            const btn = wrap.querySelector(".menu-item-desc-toggle");
            if (!p || !btn) return;
            const refreshClampState = () => {
              p.classList.add("is-clamped");
              btn.hidden = true;
              btn.textContent = "More";
              btn.setAttribute("aria-expanded", "false");
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  btn.hidden = !(p.scrollHeight > p.clientHeight + 1);
                });
              });
            };
            refreshClampState();
            btn.addEventListener("click", () => {
              const open = btn.getAttribute("aria-expanded") === "true";
              if (open) {
                refreshClampState();
              } else {
                p.classList.remove("is-clamped");
                btn.setAttribute("aria-expanded", "true");
                btn.textContent = "Hide";
                btn.hidden = false;
              }
            });
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", wireGuestDescToggles);
        } else {
          wireGuestDescToggles();
        }
      })();
    </script>

    <script
      define:vars={{
        hasPdf: showPdfPanel,
        hasDigital: showDigitalPanel,
        showPdfPanel,
        pdfUrl,
        apiBaseUrl,
        analyticsTrackUsername,
        analyticsBusinessId,
        analyticsLocationId,
        analyticsMenuId,
      }}
    >
      if (analyticsTrackUsername) {
        const sessionId = `${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
        fetch(`${apiBaseUrl}/analytics/shop/${encodeURIComponent(analyticsTrackUsername)}/track`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            session_id: sessionId,
            business_id: analyticsBusinessId || null,
            location_id: analyticsLocationId || null,
            menu_id: analyticsMenuId || null,
            event_type: "view",
          }),
        }).catch(() => void 0);
      }

      const useLegacyPdf = Boolean(showPdfPanel && pdfUrl);
      if (useLegacyPdf) {
        document.body.classList.add("pdf-legacy");
        const loadPdfJs = () =>
          new Promise((resolve, reject) => {
            if (window.pdfjsLib) return resolve(window.pdfjsLib);
            const s = document.createElement("script");
            s.src = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js";
            s.onload = () => resolve(window.pdfjsLib);
            s.onerror = reject;
            document.head.appendChild(s);
          });

        const list = document.getElementById("legacyPdfList");
        const loading = document.getElementById("legacyPdfLoading");
        const modal = document.getElementById("legacyPdfModal");
        const modalImg = document.getElementById("legacyPdfModalImg");

        const openModal = (src) => {
          if (!modal || !modalImg || window.innerWidth <= 900) return;
          modalImg.src = src;
          modal.classList.add("active");
        };
        if (modal) {
          modal.addEventListener("click", () => modal.classList.remove("active"));
        }

        (async () => {
          try {
            const lib = await loadPdfJs();
            lib.GlobalWorkerOptions.workerSrc =
              "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
            const task = lib.getDocument(String(pdfUrl));
            const pdf = await task.promise;
            const pages = pdf.numPages;
            for (let i = 1; i <= pages; i += 1) {
              const page = await pdf.getPage(i);
              const viewport = page.getViewport({ scale: window.innerWidth <= 900 ? 1.45 : 2 });
              const canvas = document.createElement("canvas");
              const ctx = canvas.getContext("2d");
              canvas.width = Math.floor(viewport.width);
              canvas.height = Math.floor(viewport.height);
              await page.render({ canvasContext: ctx, viewport }).promise;
              const img = document.createElement("img");
              img.src = canvas.toDataURL("image/jpeg", 0.95);
              img.alt = `Menu page ${i}`;
              img.addEventListener("click", () => openModal(img.src));
              const wrap = document.createElement("div");
              wrap.className = "legacy-page";
              wrap.appendChild(img);
              list?.appendChild(wrap);
            }
            if (loading) loading.style.display = "none";
          } catch {
            if (loading) loading.textContent = "Could not load menu PDF.";
          }
        })();
      }

      // Basic inspect/copy friction for public menu pages.
      document.addEventListener("contextmenu", (event) => event.preventDefault());
      document.addEventListener("keydown", (event) => {
        const k = String(event.key || "").toLowerCase();
        if (k === "f12") event.preventDefault();
        if (event.ctrlKey && event.shiftKey && (k === "i" || k === "j" || k === "c")) {
          event.preventDefault();
        }
        if (event.ctrlKey && k === "u") event.preventDefault();
      });
    </script>
  </body>
</html>
