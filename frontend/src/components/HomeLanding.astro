---
import BrandMark from "./BrandMark.astro";
const partnerSignupUrl = (
	(import.meta as any).env?.PUBLIC_PARTNER_SIGNUP_URL || ""
).replace(/\/$/, "");
const publicApiUrl =
	((import.meta as any).env?.PUBLIC_API_URL as string) ||
	((import.meta as any).env?.MODE === "production"
		? "https://epatri-be.vercel.app/api/v1"
		: "http://localhost:5000/api/v1");

let impactStats = {
	saved: 0,
	given: 0,
	menus_created: 0,
	business_growth_percentage: 0,
	environment_saving_percentage: 0,
	area_coverage_count: 0,
};

try {
	const res = await fetch(`${publicApiUrl}/public/impact/trees`);
	if (res.ok) {
		const payload = await res.json();
		impactStats = {
			saved: Number(payload?.saved || impactStats.saved),
			given: Number(payload?.given || impactStats.given),
			menus_created: Number(payload?.menus_created || 0),
			business_growth_percentage: Number(payload?.business_growth_percentage || 0),
			environment_saving_percentage: Number(payload?.environment_saving_percentage || 0),
			area_coverage_count: Number(payload?.area_coverage_count || 0),
		};
	}
} catch {
	// Keep fallback counters if API is unreachable during static build/runtime.
}
