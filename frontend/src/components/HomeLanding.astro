<script is:inline>
	(() => {
		const runCounter = (el) => {
			if (el.getAttribute("data-animated") === "1") return;
			const target = Math.max(0, Number(el.getAttribute("data-target") || 0));
			const suffix = el.getAttribute("data-suffix") || "";
			const durationMs = 1800;
			const startedAt = performance.now();
			const step = (now) => {
				const progress = Math.min((now - startedAt) / durationMs, 1);
				const eased = 1 - Math.pow(1 - progress, 3);
				const value = Math.round(target * eased);
				el.textContent = `${value.toLocaleString()}${suffix}`;
				if (progress < 1) {
					requestAnimationFrame(step);
				} else {
					el.setAttribute("data-animated", "1");
				}
			};
			requestAnimationFrame(step);
		};

		const initCountersWhenVisible = () => {
			const counters = document.querySelectorAll(".js-count-up");
			if (!counters.length) return;
			const impactSection = document.querySelector(".impact-stats");
			if (!impactSection) {
				counters.forEach((el) => runCounter(el));
				return;
			}

			const triggerAll = () => counters.forEach((el) => runCounter(el));
			const rect = impactSection.getBoundingClientRect();
			const viewportHeight =
				window.innerHeight || document.documentElement.clientHeight || 0;
			const alreadyVisible = rect.top < viewportHeight * 0.9 && rect.bottom > 0;
			if (alreadyVisible) {
				triggerAll();
				return;
			}

			if (!("IntersectionObserver" in window)) {
				triggerAll();
				return;
			}

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					triggerAll();
					observer.disconnect();
				});
			}, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
			observer.observe(impactSection);
			// Hard fallback if observer never fires due edge browser behavior.
			setTimeout(triggerAll, 1400);
		};

		const boot = () => setTimeout(initCountersWhenVisible, 0);
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", boot);
		} else {
			boot();
		}
		window.addEventListener("load", boot);
		window.addEventListener("pageshow", boot);
		document.addEventListener("astro:page-load", boot);
	})();
</script>

<style>
