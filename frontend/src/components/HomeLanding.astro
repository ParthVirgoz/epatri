---
const partnerSignupUrl = import.meta.env.PUBLIC_PARTNER_SIGNUP_URL?.replace(/\/$/, "") || "";
---

<div class="landing">
	<header class="landing__header">
		<a href="/" class="landing__logo" aria-label="ePatri home">
			<span class="landing__logo-e">e</span><span class="landing__logo-patri">Patri</span>
		</a>
		{partnerSignupUrl ? (
			<a href={`${partnerSignupUrl}/register`} class="landing__header-cta">
				List your menu
			</a>
		) : (
			<span class="landing__header-note">Partner signup URL coming soon</span>
		)}
	</header>

	<main>
		<section class="hero">
			<p class="eyebrow">Digital menus · One link</p>
			<h1>Paper menus cost trees. <span class="hero__accent">E-menus don&apos;t.</span></h1>
			<p class="lede">
				<strong>ePatri</strong> is a simple way for restaurants and cafés to share a menu from a single link —
				your guests open a clean digital menu on their phone, and you skip reprinting every time a dish changes.
			</p>
		</section>

		<section class="panel">
			<h2>What is ePatri?</h2>
			<p>
				The name pairs <span class="c-e">e</span> (electronic, easy) with <span class="c-p">Patri</span> — a nod
				to care for place and planet. We built a lightweight flow: you keep your menu as a PDF, we host the
				guest experience, and you get a shareable link for Instagram bios, QR codes, and chat.
			</p>
		</section>

		<section class="panel panel--earth">
			<h2>How you help the Earth</h2>
			<ul>
				<li>
					<strong>Fewer paper menus</strong> — no stacks thrown away after each price or dish update.
				</li>
				<li>
					<strong>Less ink and transport</strong> — one file online replaces many print runs.
				</li>
				<li>
					<strong>A signal to venues</strong> — when you ask for an <em>e-menu</em>, you remind owners that
					guests care about waste. Small asks add up.
				</li>
			</ul>
		</section>

		<section class="panel">
			<h2>Running a business? Here&apos;s how to join</h2>
			<ol class="steps">
				<li>
					<strong>Create a partner account</strong> on the ePatri admin app{partnerSignupUrl ? " — " : "."}
					{partnerSignupUrl ? (
						<a href={`${partnerSignupUrl}/register`} target="_blank">Open signup</a>
					) : (
						<span class="muted">Set <code>PUBLIC_PARTNER_SIGNUP_URL</code> to your admin URL for a direct link.</span>
					)}
				</li>
				<li>
					<strong>Upload your menu PDF</strong> and pick a short username for your public link.
				</li>
				<li>
					<strong>Share your link</strong> everywhere guests look — bio, table QR, receipts, and messages.
				</li>
			</ol>
		</section>

		<section class="panel panel--patron">
			<h2>Ordering as a guest?</h2>
			<p>
				When your favourite spot sends an ePatri link, open it on your phone — that&apos;s their live menu. If
				they still only have laminated paper, it&apos;s okay to say you&apos;d love an <strong>e-menu</strong> next
				time. You&apos;re not nagging; you&apos;re helping them save money and waste, and you&apos;re part of a
				bigger shift away from throwaway paper.
			</p>
		</section>

		<section class="footer-cta">
			<p>
				Together we can make <span class="c-e">e</span><span class="c-p">Patri</span> the norm — better for
				businesses, guests, and the trees we keep standing.
			</p>
		</section>
	</main>

	<footer class="landing__footer">
		<p class="muted small">© {new Date().getFullYear()} ePatri</p>
	</footer>
</div>

<style>
	.landing {
		--e: #1e9459;
		--patri: #ff9423;
		--ink: #1a1a1a;
		--muted: #5c5c5c;
		--bg: #f7faf8;
		--card: #ffffff;
		min-height: 100vh;
		background: var(--bg);
		color: var(--ink);
	}

	.landing__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid #e5e5e5;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(8px);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.landing__logo {
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.landing__logo-e {
		color: var(--e);
	}
	.landing__logo-patri {
		color: var(--patri);
	}

	.landing__header-cta {
		flex-shrink: 0;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		background: var(--e);
		color: #fff;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}
	.landing__header-cta:hover {
		filter: brightness(0.95);
	}

	.landing__header-note {
		font-size: 0.75rem;
		color: var(--muted);
		max-width: 10rem;
		text-align: right;
		line-height: 1.3;
	}

	main {
		max-width: 40rem;
		margin: 0 auto;
		padding: 2rem 1.25rem 4rem;
	}

	.hero {
		margin-bottom: 2.5rem;
	}

	.eyebrow {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--e);
		margin: 0 0 0.75rem;
	}

	.hero h1 {
		font-size: clamp(1.75rem, 5vw, 2.35rem);
		font-weight: 700;
		line-height: 1.15;
		margin: 0 0 1rem;
		letter-spacing: -0.03em;
	}

	.hero__accent {
		color: var(--e);
	}

	.lede {
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--muted);
		margin: 0;
	}

	.panel {
		background: var(--card);
		border: 1px solid #e8e8e8;
		border-radius: 1rem;
		padding: 1.35rem 1.25rem;
		margin-bottom: 1.25rem;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
	}

	.panel h2 {
		font-size: 1.05rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	.panel p,
	.panel li {
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
		margin: 0;
	}

	.panel ul {
		margin: 0;
		padding-left: 1.1rem;
	}
	.panel li {
		margin-bottom: 0.5rem;
	}

	.panel--earth {
		border-color: #cfe8d9;
		background: linear-gradient(160deg, #f4fbf7 0%, #fffaf5 100%);
	}

	.panel--patron {
		border-color: #fde6cc;
		background: #fffaf5;
	}

	.c-e {
		color: var(--e);
		font-weight: 600;
	}
	.c-p {
		color: var(--patri);
		font-weight: 600;
	}

	.steps {
		margin: 0;
		padding-left: 1.1rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.steps li {
		margin-bottom: 0.65rem;
	}
	.steps a {
		color: var(--e);
		font-weight: 600;
	}

	code {
		font-size: 0.8rem;
		background: #f0f0f0;
		padding: 0.1rem 0.35rem;
		border-radius: 4px;
	}

	.muted {
		color: var(--muted);
	}
	.small {
		font-size: 0.8rem;
	}

	.footer-cta {
		text-align: center;
		padding: 1.5rem 0.5rem 0;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.5;
		color: var(--ink);
	}

	.landing__footer {
		text-align: center;
		padding: 1rem 1.25rem 2rem;
		border-top: 1px solid #eaeaea;
		background: #fff;
	}
</style>
