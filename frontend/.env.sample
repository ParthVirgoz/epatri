# Canonical site origin (no trailing slash). Stabilizes canonical URLs, Open Graph, and JSON-LD in production.
# PUBLIC_SITE_URL=https://epatri.vercel.app

# Optional 1200×630 (or similar) image URL for social previews when sharing the homepage or menus.
# PUBLIC_DEFAULT_OG_IMAGE=https://epatri.vercel.app/og-default.png

# Backend API (include /api/v1)
PUBLIC_API_URL=http://localhost:5000/api/v1

# Partner admin (Vite) base URL — no trailing slash. Powers “List your menu” / signup links on the public landing page.
# PUBLIC_PARTNER_SIGNUP_URL=http://localhost:5173

# Optional primary CTA URL on public guest menus. If unset, menus use PUBLIC_PARTNER_SIGNUP_URL + /register, else this site’s home URL.
# PUBLIC_CREATE_MENU_CTA_URL=https://example.com/your-hub

# Optional social icons in the guest menu footer. Omitted icons are hidden.
# PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yourbrand
# PUBLIC_SOCIAL_X=https://x.com/yourbrand
# PUBLIC_SOCIAL_GITHUB=https://github.com/yourorg
# PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/yourbrand
