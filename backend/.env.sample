NODE_ENV=development
PORT=5000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Extra origins merged with built-in defaults (localhost + epatri *.vercel.app). Comma or newline separated.
# If you set ALLOWED_ORIGINS to only spaces or typos, older code could end up with an empty list and block everyone.
# Trailing slashes are not valid in the Origin header — use https://myapp.vercel.app not https://myapp.vercel.app/
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4321,http://127.0.0.1:5173,http://127.0.0.1:4321

# Set true to allow any https://*.vercel.app origin (preview deployments). Optional; off by default.
# CORS_ALLOW_VERCEL_PREVIEWS=false

# Admin SPA URL for Supabase password recovery redirect
ADMIN_FRONTEND_URL=http://localhost:5173

# Optional full override for password recovery redirect.
# If set, backend uses this URL directly for Supabase reset emails.
# Example: https://admin.epatri.com/reset-password
# PASSWORD_RESET_REDIRECT_URL=

# Optional (unused by current Supabase JWT flow; reserved)
# JWT_SECRET=

# IANA timezone for menu schedule rules (weekdays + calendar dates). Default UTC. Example: Asia/Kolkata
# MENU_SCHEDULE_TZ=UTC

# Place search (onboarding): User-Agent for Nominatim (https://operations.osmfoundation.org/policies/nominatim/)
# NOMINATIM_USER_AGENT=epatri-backend/1.0 (https://example.com/contact)

# Signed URL lifetime (seconds) for menu PDFs in private Supabase Storage bucket `menus`. Default 3600; min 60; max 86400.
# MENU_PDF_SIGNED_URL_TTL_SEC=3600
